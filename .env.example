# Project URL for your separate Smart Parking Supabase project.
SUPABASE_URL=https://wiyjgmwktmopddvoudsm.supabase.co

# Put a server-side Supabase secret key (sb_secret_...) here.
# Do not use a publishable key for this local admin dashboard and never commit the real .env file.
SUPABASE_SECRET_KEY=

FLASK_SECRET_KEY=replace-with-a-random-local-value

# Allow the ESP32 on your trusted home Wi-Fi to reach Flask.
# The web dashboard itself stays restricted to this computer.
PARKING_HOST=0.0.0.0

# Generate a random value and use the same value in firmware/ParkingGate/secrets.h.
ESP32_API_KEY=replace-with-a-long-random-device-key
